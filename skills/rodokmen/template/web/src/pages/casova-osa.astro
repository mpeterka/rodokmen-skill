---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { events, eras, lineByK } from '../lib/data.js';
const ROOT_COLOR = '#8a6d52';
// události předků a dějinné události v jednom proudu, řazené podle roku (dějiny před událostmi téhož roku)
const items = [...eras.map((e) => ({ era: e, year: e.od, o: 0 })), ...events.map((e) => ({ ev: e, year: e.year, o: 1 }))]
  .sort((a, b) => a.year - b.year || a.o - b.o);
const centuries = [];
for (const it of items) {
  const c = Math.floor((it.year - 1) / 100) + 1, d = Math.floor(it.year / 10) * 10;
  let C = centuries.at(-1);
  if (!C || C.c !== c) centuries.push((C = { c, decades: [] }));
  let D = C.decades.at(-1);
  if (!D || D.d !== d) C.decades.push((D = { d, items: [] }));
  D.items.push(it);
}
const wiki = (t) => `https://cs.wikipedia.org/wiki/${encodeURIComponent(t.replaceAll(' ', '_'))}`;
---
<Base title="Časová osa">
  <h1>Časová osa rodu</h1>
  <p class="lead">Narození, sňatky a úmrtí předků v pořadí, jak šly za sebou, a mezi nimi dějiny, které je potkaly
    – vybrané podle obcí a let, kdy tam rod žil. Barevný proužek je rod.</p>
  {items.length === 0 && <p>Osa se naplní, až budou ve faktech osob roky („* 14. 2. 1890 Holice“).</p>}
  {items.length > 0 && (
    <div class="osa-ovladani">
      {centuries.length > 1 && <nav>{centuries.map((C) => <a href={`#stoleti-${C.c}`}>{C.c}. století</a>)}</nav>}
      {eras.length > 0 && <label><input type="checkbox" id="osa-dejiny" checked /> dějinné události</label>}
    </div>
  )}
  {centuries.map((C) => (
    <section id={`stoleti-${C.c}`}>
      <h2>{C.c}. století</h2>
      {C.decades.map((D) => (
        <div class="osa-dekada">
          <h3>{D.d}. léta</h3>
          <ul class="osa">
            {D.items.map(({ ev: e, era: u }) => u ? (
              <li class={`osa-era${u.mistni ? ' osa-era--mistni' : ''}`}>
                <div class="osa-era__hlava">
                  <span class="osa-rok">{u.od === u.do ? u.od : `${u.od}–${u.do}`}</span>
                  <strong>{u.nazev}</strong>
                </div>
                <p>{u.text}</p>
                <p class="small muted">
                  {u.mistni ? 'Blízko míst rodu' : 'Z míst rodu'}: {u.mista.join(', ')}{u.km != null && u.km > 0 ? ` (nejblíž ${u.km} km)` : ''}
                  {u.wiki && <> · <a href={wiki(u.wiki)} target="_blank" rel="noopener">Wikipedie ↗</a></>}
                  {u.zdroj && <> · <a href={u.zdroj} target="_blank" rel="noopener">pramen ↗</a></>}
                </p>
              </li>
            ) : (
              <li class="osa-ev" style={`--c:${lineByK[e.line]?.color ?? ROOT_COLOR}`}>
                <span class="osa-rok">{e.date}</span>
                <span class="osa-sym" title={e.kindName}>{e.kind}</span>
                <span>{e.people.map((s, i) => <>{i > 0 && ' a '}<PersonLink slug={s} showYears={false} /></>)}
                  <span class="muted small"> – {e.kindName}{e.text.slice(e.date.length).trim() ? `, ${e.text.slice(e.date.length).trim()}` : ''}</span></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</Base>

<script>
  const cb = document.querySelector<HTMLInputElement>('#osa-dejiny');
  cb?.addEventListener('change', () => document.body.classList.toggle('bez-dejin', !cb.checked));
</script>

<style is:global>
  .osa-ovladani { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1rem; margin: 0.8rem 0 0.4rem;
    position: sticky; top: 0; background: var(--bg, #fbf8f2); padding: 0.4rem 0; z-index: 2; }
  .osa-ovladani nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .osa-dekada h3 { font-size: 0.95rem; color: var(--muted); margin: 1rem 0 0.3rem; }
  .osa { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  .osa-ev { display: grid; grid-template-columns: 6.5rem 1.2rem 1fr; gap: 0.4rem; align-items: baseline;
    padding: 0.25rem 0 0.25rem 0.7rem; border-left: 4px solid var(--c); margin-left: -3px; }
  .osa-rok { font-variant-numeric: tabular-nums; color: var(--muted); font-size: 0.9rem; }
  .osa-sym { font-weight: 700; text-align: center; }
  .osa-era { margin: 0.5rem 0 0.5rem 0.7rem; padding: 0.6rem 0.9rem; background: var(--paper); border: 1px solid var(--line);
    border-left: 4px solid #6e6153; border-radius: 8px; }
  .osa-era--mistni { border-left-color: #c0703a; }
  .osa-era__hlava { display: flex; gap: 0.7rem; align-items: baseline; flex-wrap: wrap; }
  .osa-era p { margin: 0.3rem 0 0; }
  .bez-dejin .osa-era { display: none; }
  @media (max-width: 520px) { .osa-ev { grid-template-columns: 4.8rem 1rem 1fr; } }
</style>
